---
import { plans, type PlanId } from '../data/plans';
import Icon from './ui/Icon.astro';

interface Props { order?: PlanId[]; highlights?: boolean }
const { order = ['free', 'solo', 'elite'], highlights = true } = Astro.props;
const list = order.map((id) => plans[id]);
---

<div class="plans" data-reveal>
  {list.map((p, i) => (
    <div class:list={['plan', { 'plan--lead': p.lead }]} style={`--i:${i}`}>
      {p.lead && <p class="plan__flag">Most Popular</p>}
      <div class="plan__body">
        <div class="plan__top">
          <h3 class="plan__name">{p.name}</h3>
          <span class="plan__note">{p.note}</span>
        </div>
        <p class="plan__price"><b>{p.price}</b><span>/month</span></p>
        <p class="plan__who">{p.who}</p>
        <a class:list={['btn', 'plan__cta', { 'btn--ghost': !p.lead }]} href={p.href}>{p.cta}</a>
        {highlights && (
          <ul class="plan__list">
            {p.highlights.map((h) => <li><Icon name="check" size={16} />{h}</li>)}
          </ul>
        )}
      </div>
    </div>
  ))}
</div>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: end; }
  .plan {
    position: relative; border-radius: 24px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.6));
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    backdrop-filter: blur(20px) saturate(1.5);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8), 0 0 0 1px rgb(10 10 10 / 0.05), 0 24px 48px -32px rgb(18 40 90 / 0.25);
    transition: transform 300ms var(--ease-out), box-shadow 300ms ease;
  }
  .plan--lead { background: var(--blue); padding: 0 4px 4px; box-shadow: 0 30px 60px -28px rgb(18 109 251 / 0.55); }
  .plan__flag { text-align: center; color: #fff; font-size: 0.875rem; font-weight: 600; padding: 10px 0; }
  .plan--lead .plan__body { background: #fff; border-radius: 21px; }
  .plan__body { padding: 28px; display: grid; gap: 10px; align-content: start; }
  @media (hover: hover) and (pointer: fine) {
    .plan:hover { transform: translateY(-4px); }
  }
  .plan__top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .plan__name { font-size: 1.125rem; font-weight: 650; letter-spacing: -0.015em; }
  .plan__note {
    font-size: 0.75rem; font-weight: 600; color: #0f7a46; background: #def7e8;
    box-shadow: inset 0 0 0 1px #b6ebcb; padding: 3px 9px; border-radius: 999px; white-space: nowrap;
  }
  .plan__price { display: flex; align-items: baseline; gap: 4px; margin-top: 10px; }
  .plan__price b { font-size: 3.25rem; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .plan__price span { color: var(--ink-3); }
  .plan__who { color: var(--ink-2); font-size: 0.975rem; min-height: 3.1em; }
  .plan__cta { width: 100%; margin-top: 6px; }
  .plan__list { list-style: none; margin: 14px 0 0; padding: 16px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; }
  .plan__list li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.9375rem; color: var(--ink-2); }
  .plan__list :global(svg) { flex: none; margin-top: 3px; color: var(--blue); }

  .js .plans[data-reveal] .plan { opacity: 0; transform: translateY(16px); transition: opacity 600ms var(--ease-out), transform 700ms var(--ease-out); transition-delay: calc(var(--i) * 80ms); }
  .js .plans[data-reveal].is-in .plan { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .plans { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }
    .plan--lead { order: -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .plans[data-reveal] .plan { transform: none; transition: opacity 300ms ease; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .plan:not(.plan--lead) { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  @media (prefers-contrast: more) {
    .plan:not(.plan--lead) { background: var(--surface); box-shadow: 0 0 0 1px var(--ink-3); }
  }
</style>
