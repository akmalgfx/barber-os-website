---
import Icon from './ui/Icon.astro';

// Figures supplied by Barber-OS, as of August 2026.
const stats = [
  { icon: 'users', value: 1403, prefix: '', suffix: '+', label: 'Barbers On BOS' },
  { icon: 'check', value: 644210, prefix: '', suffix: '+', label: 'Services Completed', ring: true },
  { icon: 'card', value: 21, prefix: '$', suffix: 'M+', label: 'Transaction Volume' },
];
---

<section class="stats" aria-label="Barber-OS in numbers">
  <div class="wrap">
    <ul class="stats__row" data-stats>
      {stats.map((s, i) => (
        <li class="stat" data-reveal style={`--i:${i}`}>
          <span class="stat__rail" aria-hidden="true"><i></i><i></i></span>
          <span class="stat__ico" aria-hidden="true">
            {s.ring ? <span class="stat__ring"><Icon name="check" size={16} /></span> : <Icon name={s.icon} size={22} />}
          </span>
          <p class="stat__num num">
            <span data-count={s.value} data-prefix={s.prefix} data-suffix={s.suffix}>{s.prefix}{s.value.toLocaleString('en-US')}{s.suffix}</span>
          </p>
          <p class="stat__label">{s.label}</p>
          <p class="stat__asof">as of August 2026</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats { padding: 0; }
  .stats__row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 4vw, 64px); }
  .stat {
    position: relative; display: grid; justify-items: center; text-align: center;
    padding: 28px 24px 30px; border-radius: 16px;
    background: linear-gradient(180deg, #f0f0f1, #ececed);
    box-shadow: inset 0 0 0 1px rgb(10 10 10 / 0.07), inset 0 1px 0 rgb(255 255 255 / 0.8);
    overflow: hidden;
  }
  .js .stat[data-reveal] { transition-delay: calc(var(--i) * 80ms); }

  /* The rail the icon sits on: a hairline that fades at both ends, with two nodes. */
  .stat__rail {
    position: absolute; left: 0; right: 0; top: 56px; height: 1px;
    background: linear-gradient(90deg, transparent, rgb(10 10 10 / 0.1) 20%, rgb(10 10 10 / 0.1) 80%, transparent);
  }
  .stat__rail i {
    position: absolute; top: -3.5px; width: 8px; height: 8px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 0 1px rgb(10 10 10 / 0.14);
  }
  .stat__rail i:first-child { left: calc(50% - 62px); }
  .stat__rail i:last-child { right: calc(50% - 62px); }
  .js .stat__rail { transform: scaleX(0.2); opacity: 0; transition: transform 900ms var(--ease-out), opacity 600ms ease; transition-delay: calc(var(--i) * 80ms + 200ms); }
  .js .stat.is-in .stat__rail { transform: none; opacity: 1; }

  .stat__ico {
    position: relative; z-index: 1;
    width: 52px; height: 52px; border-radius: 13px; display: grid; place-items: center;
    color: #fff; background: linear-gradient(180deg, #3a3a3d, #141416);
    box-shadow: 0 0 0 2px var(--blue), 0 6px 14px -4px rgb(18 109 251 / 0.45), inset 0 1px 0 rgb(255 255 255 / 0.15);
  }
  .stat__ring { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1.6px #fff; }
  .stat__num {
    margin-top: 22px;
    font-size: clamp(2.25rem, 4vw, 3rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1;
  }
  .stat__label { margin-top: 12px; font-size: 1.0625rem; color: var(--ink-2); }
  .stat__asof { margin-top: 6px; font-size: 0.875rem; color: var(--ink-3); }

  @media (max-width: 820px) {
    .stats__row { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
  }
</style>

<script>
  // Count up once when the row comes into view. The final figure is already in the HTML.
  const row = document.querySelector<HTMLElement>('[data-stats]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (row && !reduce) {
    const nums = [...row.querySelectorAll<HTMLElement>('[data-count]')];
    const fmt = (el: HTMLElement, v: number) =>
      (el.textContent = `${el.dataset.prefix}${Math.round(v).toLocaleString('en-US')}${el.dataset.suffix}`);
    nums.forEach((el) => fmt(el, 0));
    const io = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      io.disconnect();
      nums.forEach((el, i) => {
        const end = Number(el.dataset.count);
        const dur = 1400;
        const t0 = performance.now() + i * 80;
        const step = (now: number) => {
          const t = Math.min(1, Math.max(0, (now - t0) / dur));
          fmt(el, end * (1 - Math.pow(1 - t, 4)));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.4 });
    io.observe(row);
  }
</script>
