---
// A glass card with a device floating in an inset stage. Used by /app-download and /login.
// The actions (store buttons, login buttons) go in the default slot.
interface Props {
  name: string;
  role: string;
  /** Space-separated RGB channels, e.g. "18 109 251". */
  accent: string;
  text: string;
  img: string;
  w: number;
  h: number;
  kind: 'phone' | 'tablet';
  index: number;
  /** The app's own B mark for the icon tile. */
  mark?: string;
}
const { name, role, accent, text, img, w, h, kind, index, mark = '/img/bos-mark-light.png' } = Astro.props;
---

<article class="app-card" data-reveal data-app-card style={`--accent:${accent};--i:${index}`}>
  <div class:list={['app-card__stage', `app-card__stage--${kind}`]}>
    <span class="app-card__glow" aria-hidden="true"></span>
    <span class="app-card__role">{role}</span>
    <img src={img} alt={`${name} screen`} width={w} height={h} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
  </div>
  <div class="app-card__body">
    <div class="app-card__title">
      <span class="app-card__ico"><img src={mark} alt="" /></span>
      <h2 class="app-card__name">{name}</h2>
    </div>
    <p class="app-card__text">{text}</p>
    <slot />
  </div>
</article>

<style>
  .app-card {
    position: relative; isolation: isolate; display: grid; grid-template-rows: auto 1fr;
    padding: 10px; border-radius: 30px;
    background: linear-gradient(150deg, rgb(255 255 255 / 0.62), rgb(255 255 255 / 0.32));
    -webkit-backdrop-filter: blur(24px) saturate(1.7);
    backdrop-filter: blur(24px) saturate(1.7);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      0 0 0 1px rgb(10 10 10 / 0.04),
      0 30px 60px -34px rgb(var(--accent) / 0.45);
    transition: transform 400ms var(--ease-out), box-shadow 400ms ease;
  }
  .app-card::before {
    /* Frosted grain */
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none;
    background-image: var(--grain); background-size: 160px; opacity: 0.06; mix-blend-mode: multiply;
  }
  .app-card::after {
    /* Light that follows the pointer */
    content: ''; position: absolute; inset: 0; z-index: 2; border-radius: inherit; pointer-events: none;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.35), transparent 60%);
    opacity: 0; transition: opacity 300ms ease;
  }
  :global(.js) .app-card[data-reveal] { transition-delay: calc(var(--i) * 90ms); }

  /* Inset glass stage the device floats in */
  .app-card__stage {
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; place-items: center; height: 360px; padding: 48px 20px 0;
    border-radius: 22px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.15));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.75), inset 0 -24px 40px -30px rgb(var(--accent) / 0.35);
  }
  .app-card__glow {
    position: absolute; z-index: -1; left: 50%; top: 58%; width: 80%; aspect-ratio: 1; border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgb(var(--accent) / 0.42), rgb(var(--accent) / 0.12) 55%, transparent);
    transition: transform 600ms var(--ease-out), opacity 400ms ease;
  }
  .app-card__role {
    position: absolute; top: 14px; left: 14px;
    padding: 5px 11px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; color: rgb(var(--accent));
    background: rgb(255 255 255 / 0.6);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.85), 0 1px 2px rgb(10 10 10 / 0.06);
  }
  .app-card__role::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 7px; vertical-align: 1px; border-radius: 50%; background: rgb(var(--accent)); }
  .app-card__stage img {
    filter: drop-shadow(0 22px 26px rgb(10 20 40 / 0.22));
    transition: transform 600ms var(--ease-out);
  }
  .app-card__stage--phone { place-items: end center; }
  .app-card__stage--phone img { height: 330px; width: auto; transform: translateY(18px); }
  .app-card__stage--tablet img { width: 100%; max-height: 250px; object-fit: contain; transform: translateY(14px); }

  .app-card__body { display: grid; gap: 14px; align-content: start; padding: 22px 18px 20px; }
  .app-card__title { display: flex; align-items: center; gap: 12px; }
  .app-card__ico {
    width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center; flex: none;
    background: linear-gradient(160deg, rgb(0 50 66 / 0.92), rgb(0 30 40 / 0.96));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), inset 0 0 0 1px rgb(255 255 255 / 0.08), 0 8px 18px -10px rgb(10 20 40 / 0.45);
  }
  .app-card__ico img { height: 17px; width: auto; }
  .app-card__name { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
  .app-card__text { color: var(--ink-2); min-height: 4.8em; }

  @media (hover: hover) and (pointer: fine) {
    .app-card:hover { transform: translateY(-6px); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.95), 0 0 0 1px rgb(10 10 10 / 0.04), 0 40px 70px -34px rgb(var(--accent) / 0.6); }
    .app-card:hover::after { opacity: 1; }
    .app-card:hover .app-card__stage img { transform: translateY(4px) scale(1.02); }
    .app-card:hover .app-card__glow { transform: translate(-50%, -50%) scale(1.12); }
  }
  @media (max-width: 980px) {
    .app-card__text { min-height: 0; }
  }
  @media (max-width: 420px) {
    .app-card__stage { height: 320px; }
    .app-card__stage--phone img { height: 290px; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .app-card, .app-card__role { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  @media (prefers-contrast: more) {
    .app-card { background: var(--surface); box-shadow: 0 0 0 1px var(--ink-3); }
  }
</style>

<script>
  // Pointer light on the glass. Written on the card itself so only its glare repaints.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-app-card]').forEach((card) => {
      let raf = 0;
      card.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });
    });
  }
</script>
