---
import Icon from './ui/Icon.astro';

const products = [
  { id: 'agiva-spray', name: 'Agiva Sea Salt Texturizing Spray 300 mL', stock: 32, min: 5 },
  { id: 'agiva-dust', name: 'Agiva Styling Hair Powder Wax Strong 20g', stock: 6, min: 4 },
  { id: 'hanz-claymation', name: 'Hanz De Fuko Claymation 2oz', stock: 5, min: 3 },
  { id: 'slick-gorilla', name: 'Slick Gorilla Curl Cream 100 ml', stock: 14, min: 4 },
  { id: 'immortal-tobacco', name: 'Immortal NYC Tobacco Matte Pomade 100ML', stock: 18, min: 4 },
];
const side = ['home', 'calendar', 'bag', 'clients', 'tag', 'box', 'more'];
const labels = ['Home', 'Calendar', 'Checkout', 'Clients', 'Sales', 'Products', 'More'];
---

<article class="feature feature--wide" id="inventory" data-reveal>
  <div class="feature__copy inv__copy">
    <div>
      <p class="feature__tag">Inventory & Product Management</p>
      <h2 class="h2">Know Your Stock Before It Runs Out</h2>
    </div>
    <p class="lede">Track every product in real time, sell from the dashboard and order stock from your suppliers. Barber-OS tells you the moment something runs low.</p>
  </div>

  <div class="feature__stage">
    <div class="inv app" data-inv role="group" aria-label="Sample inventory. Scan products to sell them.">
      <div class="app__bar">
        <img src="/img/bos-mark-light.png" alt="" class="inv__logo" />
        <span class="app__icons"><Icon name="chat" /><Icon name="bell" /><Icon name="help" /></span>
      </div>
      <div class="inv__body">
        <aside class="inv__side">
          {side.map((ico, i) => <span class:list={['inv__nav', { on: labels[i] === 'Products' }]}><Icon name={ico} size={18} />{labels[i]}</span>)}
        </aside>
        <nav class="inv__sub" aria-hidden="true">
          <span class="on">Inventory</span><span>Stocktake</span><span>Stock orders</span><span>Suppliers</span><span>Gift cards</span>
        </nav>
        <div class="inv__main">
          <div class="inv__tools">
            <span class="inv__search"><Icon name="search" size={16} />Search by name or barcode</span>
            <button type="button" class="app-btn" data-scan>Scan barcode</button>
          </div>
          <table class="inv__table">
            <thead><tr><th>Product Name</th><th>Supplier</th><th>Retail Price</th><th>Total Stock</th></tr></thead>
            <tbody>
              {products.map((p) => (
                <tr data-row={p.id} data-stock={p.stock} data-min={p.min} data-name={p.name}>
                  <td><span class="inv__prod"><img src={`/img/products/${p.id}.webp`} alt="" width="160" height="155" loading="lazy" />{p.name}</span></td>
                  <td>Empire Barber Supply</td>
                  <td>$19.99</td>
                  <td><span class="inv__stock" data-count>{p.stock}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="toasts" data-toasts aria-live="polite"></div>
    </div>
    <p class="demo-note">Sample stock. Press “Scan barcode” to sell a product.</p>
  </div>
</article>

<style>
  .inv__copy { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 72px; align-items: end; }
  @media (max-width: 960px) { .inv__copy { grid-template-columns: 1fr; } }
  .inv { position: relative; }
  .inv__logo { height: 18px; width: auto; }
  .inv__body { display: grid; grid-template-columns: 72px 130px minmax(0, 1fr); min-height: 430px; }
  .inv__side { border-right: 1px solid #eceeef; padding: 10px 7px; display: grid; gap: 4px; align-content: start; }
  .inv__nav { display: grid; justify-items: center; gap: 3px; padding: 8px 2px; border-radius: 8px; font-size: 10.5px; color: #4b5257; }
  .inv__nav.on { background: var(--app-mint); color: var(--app); font-weight: 600; }
  .inv__sub { border-right: 1px solid #eceeef; padding: 12px 8px; display: grid; gap: 2px; align-content: start; }
  .inv__sub span { padding: 8px 10px; border-radius: 6px; font-size: 12.5px; color: #2a3034; }
  .inv__sub .on { background: var(--app-mint); font-weight: 500; }
  .inv__main { min-width: 0; padding: 12px 16px; }
  .inv__tools { display: flex; gap: 10px; align-items: center; margin-bottom: 6px; }
  .inv__search { flex: 1; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px; border-radius: 6px; box-shadow: inset 0 0 0 1px #d6d8da; color: #8a9196; font-size: 12.5px; white-space: nowrap; overflow: hidden; }
  .inv__table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .inv__table th { text-align: left; font-weight: 600; padding: 12px 8px; border-bottom: 1px solid #eceeef; white-space: nowrap; }
  .inv__table td { padding: 8px; border-bottom: 1px solid #f0f1f2; color: #2a3034; }
  .inv__table tr { transition: background-color 0.4s; }
  .inv__table tr.is-hit { background: #f1fbff; }
  .inv__prod { display: flex; align-items: center; gap: 12px; max-width: 280px; }
  .inv__prod img { width: 46px; height: 44px; object-fit: contain; flex: none; border-radius: 4px; }
  .inv__stock { display: inline-block; min-width: 2.2em; font-variant-numeric: tabular-nums; font-weight: 500; }
  .inv__stock.is-low { color: var(--danger); }

  .toasts { position: absolute; right: 14px; top: 52px; z-index: 4; display: grid; gap: 8px; width: min(340px, calc(100% - 28px)); pointer-events: none; }
  .toasts :global(.toast) {
    transform-origin: top right;
    display: grid; grid-template-columns: auto 1fr auto; gap: 2px 12px; align-items: center;
    padding: 12px 14px; border-radius: 16px; background: rgb(30 30 32 / 0.96); color: #fff;
    box-shadow: 0 16px 32px -12px rgb(0 0 0 / 0.5);
    animation: toast 0.45s var(--ease) both;
  }
  .toasts :global(.toast img) { grid-row: span 2; width: 34px; height: 34px; border-radius: 9px; background: #000; padding: 7px 4px; object-fit: contain; }
  .toasts :global(.toast b) { font-size: 14px; font-weight: 600; }
  .toasts :global(.toast time) { font-size: 11.5px; color: #a8abb0; }
  .toasts :global(.toast p) { grid-column: 2 / -1; font-size: 13px; color: #e8e8e8; }
  @keyframes toast { from { opacity: 0; transform: translateY(-10px) scale(0.98); } to { opacity: 1; transform: none; } }

  @media (max-width: 820px) {
    .inv__side, .inv__sub { display: none; }
    .inv__body { grid-template-columns: 1fr; }
    .inv__table th:nth-child(2), .inv__table td:nth-child(2) { display: none; }
  }
  @media (max-width: 520px) {
    .inv__table th:nth-child(3), .inv__table td:nth-child(3) { display: none; }
    .inv__search span, .inv__search { font-size: 0; gap: 0; flex: 0 0 34px; justify-content: center; padding: 0; }
    .inv__tools { justify-content: space-between; }
  }
</style>

<script>
  import { tick } from '../data/tick';
  const root = document.querySelector<HTMLElement>('[data-inv]')!;
  const rows = [...root.querySelectorAll<HTMLTableRowElement>('[data-row]')];
  const toasts = root.querySelector<HTMLElement>('[data-toasts]')!;
  // The scan cycles through what sells most in a shop: clays and powders first.
  const order = ['hanz-claymation', 'agiva-dust', 'immortal-tobacco', 'hanz-claymation', 'agiva-spray', 'agiva-dust', 'slick-gorilla'];
  let i = 0;

  const notify = (name: string) => {
    const t = document.createElement('div');
    t.className = 'toast';
    t.innerHTML = `<img src="${import.meta.env.BASE_URL.replace(/\/$/, '')}/img/bos-mark-light.png" alt=""><b>Barber-OS</b><time>Just now</time><p>Low stock for ${name.replace(/ \d.*$/, '')}.</p>`;
    toasts.prepend(t);
    while (toasts.children.length > 3) toasts.lastElementChild!.remove();
    // It leaves the way it arrived: back up and out, rather than vanishing.
    setTimeout(() => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      t.animate(
        [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: reduce ? 'none' : 'translateY(-10px) scale(0.98)' }],
        { duration: 220, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'forwards' }
      ).finished.then(() => t.remove(), () => t.remove());
    }, 6000);
  };

  root.querySelector('[data-scan]')!.addEventListener('click', () => {
    const row = rows.find((r) => r.dataset.row === order[i++ % order.length])!;
    let stock = Number(row.dataset.stock);
    if (stock <= 0) return;
    stock -= 1;
    row.dataset.stock = String(stock);
    const cell = row.querySelector<HTMLElement>('[data-count]')!;
    cell.textContent = String(stock);
    tick(cell);
    const low = stock <= Number(row.dataset.min);
    cell.classList.toggle('is-low', low);
    row.classList.add('is-hit');
    setTimeout(() => row.classList.remove('is-hit'), 700);
    if (low) notify(row.dataset.name!);
  });
</script>
