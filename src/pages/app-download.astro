---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import AppCard from '../components/AppCard.astro';
import { APPS } from '../data/site';

const apps = [
  {
    id: 'admin', name: 'Admin App', role: 'Run Operations', accent: '18 109 251',
    text: 'Track appointments, monitor performance, and stay on top of every detail, anytime, anywhere.',
    img: '/img/apps/admin-phone.webp', w: 700, h: 1436, kind: 'phone', links: APPS.admin, mark: '/img/apps/mark-admin.png',
  },
  {
    id: 'pos', name: 'POS App', role: 'Deliver Service', accent: '19 163 74',
    text: 'Simplify checkouts, manage services, and create a frictionless client experience.',
    img: '/img/apps/pos-tablet.webp', w: 1200, h: 770, kind: 'tablet', links: APPS.pos, mark: '/img/apps/mark-pos.png',
  },
  {
    id: 'kiosk', name: 'Walk-In Kiosk', role: 'Manage Your Front Door', accent: '217 154 6',
    text: 'Check clients in, manage the queue, and give every walk-in a clear place in line.',
    img: '/img/apps/kiosk-tablet.webp', w: 1200, h: 805, kind: 'tablet', links: APPS.kiosk, mark: '/img/apps/mark-kiosk.png',
  },
];
---

<Base title="Download Our Apps | Barber-OS" description="Download the Barber-OS Admin App, POS App and Walk-In Kiosk for iOS and Android.">
  <Nav />
  <main id="main">
    <section class="page-hero">
      <div class="page-hero__field" aria-hidden="true"><i></i><i></i></div>
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="pill"><Icon name="appGrid" size={15} /> Everything Your Shop Runs On</span>
          <h1 class="h1">Download Our Apps</h1>
          <p class="lede">Run operations with the <b>Admin App</b>, deliver smooth service with the <b>POS App</b>, and manage your front door with the <b>Walk-In Kiosk</b>.</p>
        </div>
      </div>
    </section>

    <section class="apps-sec">
      <div class="apps-sec__field" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="wrap apps">
        {apps.map((a, i) => (
          <AppCard name={a.name} role={a.role} accent={a.accent} text={a.text} img={a.img} w={a.w} h={a.h} kind={a.kind} index={i} mark={a.mark}>
            <div class="stores">
              <a class="store" href={a.links.ios} rel="noopener" aria-label={`${a.name} on the App Store`}>
                <img src="/img/apps/apple.png" alt="" width="96" height="96" class="store__apple" /><span><small>Download on the</small>App Store</span>
              </a>
              <a class="store" href={a.links.android} rel="noopener" aria-label={`${a.name} on Google Play`}>
                <img src="/img/apps/play.png" alt="" width="96" height="96" /><span><small>Get it on</small>Google Play</span>
              </a>
            </div>
          </AppCard>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .apps-sec { position: relative; isolation: isolate; padding: 24px 0 clamp(80px, 10vw, 128px); }
  /* Colour behind the glass, one glow per app. */
  .apps-sec__field { position: absolute; inset: -80px 0 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .apps-sec__field i { position: absolute; top: 10%; width: 46%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, var(--c), transparent); }
  .apps-sec__field i:nth-child(1) { --c: rgb(18 109 251 / 0.22); left: -6%; }
  .apps-sec__field i:nth-child(2) { --c: rgb(19 163 74 / 0.16); left: 27%; top: 22%; }
  .apps-sec__field i:nth-child(3) { --c: rgb(217 154 6 / 0.18); right: -6%; }

  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }

  /* Glass store buttons */
  .stores { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 2px; }
  .store {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px; height: 50px; padding: 0 12px;
    border-radius: 14px; color: var(--ink); text-decoration: none; font-weight: 650; font-size: 0.9375rem; line-height: 1.05;
    background: rgb(255 255 255 / 0.55);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9), 0 0 0 1px rgb(10 10 10 / 0.07), 0 4px 10px -6px rgb(10 20 40 / 0.2);
    transition: transform 160ms var(--ease-out), background-color 150ms ease, box-shadow 150ms ease;
  }
  .store img { width: 20px; height: 20px; object-fit: contain; }
  .store__apple { filter: brightness(0); }
  .store small { display: block; font-size: 0.625rem; font-weight: 500; color: var(--ink-3); }
  .store:active { transform: scale(0.97); }

  @media (hover: hover) and (pointer: fine) {
    .store:hover { background: rgb(255 255 255 / 0.85); box-shadow: inset 0 0 0 1px #fff, 0 0 0 1px rgb(10 10 10 / 0.12), 0 6px 14px -6px rgb(10 20 40 / 0.25); }
  }

  @media (max-width: 980px) {
    .apps { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
    .apps-sec__field i { width: 90%; }
    .apps-sec__field i:nth-child(1) { left: -30%; top: 0; }
    .apps-sec__field i:nth-child(2) { left: 30%; top: 33%; }
    .apps-sec__field i:nth-child(3) { right: -30%; top: 66%; }
  }
  @media (max-width: 420px) {
    .stores { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .store { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>
