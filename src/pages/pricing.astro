---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlanCards from '../components/PlanCards.astro';
import Icon from '../components/ui/Icon.astro';
import { comparison, plans } from '../data/plans';
import { GET_STARTED } from '../data/site';

const cols = [plans.free, plans.solo, plans.elite];
const faq = [
  ['Is there a free trial?', 'Yes. The Solo and Elite plans come with a 7-day free trial, and the Online Booking plan is free forever.'],
  ['Do I need special hardware to use Barber-OS?', 'No. Barber-OS works on desktops, tablets, and smartphones. However, if you want a full POS setup, we offer hardware bundles that include terminals, printers, and scanners.'],
  ['What do card payments cost?', 'Integrated payments start at 2.2% + $0.20 per payment, for both online and in-person payments.'],
  ['Can someone help me migrate from my old system?', 'Yes. Our team can assist with importing your client list, staff details, and service menus so the transition is seamless.'],
  ['Is there training included when I sign up?', 'Absolutely. Every plan includes training sessions for both owners and barbers, plus access to ongoing support and tutorials.'],
];
---

<Base
  title="Pricing | Barber-OS"
  description="Simple pricing for every barbershop. Online Booking free forever, Solo $29/month and Elite $89/month, with a 7-day free trial."
>
  <Nav />
  <main id="main">
    <section class="pr-hero">
      <div class="pr-hero__field" aria-hidden="true"><i></i><i></i></div>
      <div class="wrap">
        <div class="section-head section-head--center pr-hero__head">
          <span class="pill">Our Pricing</span>
          <h1 class="h1 pr-hero__h">Choose The Plan That Suits You</h1>
          <p class="lede">One system for booking, payments, your team and your stock. Start free, upgrade when your shop grows.</p>
        </div>
        <PlanCards />
        <p class="small pr-hero__fee">Card payments start at 2.2% + $0.20 per payment. Add-ons are available on Solo and Elite.</p>
      </div>
    </section>

    <section class="section cmp" id="compare">
      <div class="wrap">
        <div class="section-head section-head--center" data-reveal>
          <span class="pill">Find Your Perfect Plan</span>
          <h2 class="h2">Plan Comparison</h2>
          <ul class="legend" aria-label="Legend">
            <li><span class="mark mark--y"><Icon name="check" size={14} /></span>Included</li>
            <li><span class="mark mark--l">!</span>Limited</li>
            <li><span class="mark mark--n"><Icon name="close" size={12} /></span>Not included</li>
          </ul>
        </div>

        <div class="cmp__head" data-cmp-head>
          <div class="cmp__head-in">
            <span class="cmp__head-label">Compare plans</span>
            {cols.map((p) => (
              <span class:list={['cmp__plan', { 'is-lead': p.lead }]}>
                <b>{p.short}</b><small>{p.price}/mo</small>
              </span>
            ))}
          </div>
        </div>

        {comparison.map((g) => (
          <div class="cmp__group" data-reveal>
            <table class="cmp__table">
              <caption class="sr-only">{g.title}</caption>
              <thead>
                <tr>
                  <th scope="col" class="cmp__gtitle">{g.title}</th>
                  {cols.map((p) => <th scope="col" class="cmp__colh">{p.short}</th>)}
                </tr>
              </thead>
              <tbody>
                {g.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    {'cells' in row ? (
                      row.cells.map((c) => (
                        <td>
                          {c === 'y' && <span class="mark mark--y" title="Included"><Icon name="check" size={14} /><span class="sr-only">Included</span></span>}
                          {c === 'l' && <span class="mark mark--l" title="Limited">!<span class="sr-only">Limited</span></span>}
                          {c === 'n' && <span class="mark mark--n" title="Not included"><Icon name="close" size={12} /><span class="sr-only">Not included</span></span>}
                        </td>
                      ))
                    ) : (
                      <>
                        <td><span class="mark mark--n" title="Not included"><Icon name="close" size={12} /><span class="sr-only">Not included</span></span></td>
                        <td colspan="2" class="cmp__addon">{row.addon}</td>
                      </>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </section>

    <section class="section pr-faq">
      <div class="wrap faq">
        <div data-reveal>
          <h2 class="h2">Pricing Questions</h2>
          <p class="lede faq__lede">Still deciding? <a class="link" href="/contact-us">Talk to our team</a></p>
        </div>
        <div class="faq__list" data-reveal>
          {faq.map(([q, a], i) => (
            <details open={i === 0}>
              <summary>{q}<Icon name="plus" size={18} /></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pr-cta">
      <div class="wrap">
        <div class="pr-cta__box" data-reveal>
          <h2 class="h2">Power Your Barbershop With Barber-OS</h2>
          <p class="lede">Most shops are up and running within a day.</p>
          <a class="btn" href={GET_STARTED}>Get Started</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .pill {
    display: inline-block; padding: 5px 12px; border-radius: 999px;
    font-size: 0.875rem; font-weight: 500; color: var(--blue);
    background: var(--blue-soft); box-shadow: inset 0 0 0 1px rgb(18 109 251 / 0.25);
  }

  .pr-hero { position: relative; isolation: isolate; padding: clamp(56px, 8vw, 104px) 0 clamp(64px, 8vw, 104px); }
  .pr-hero__field { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .pr-hero__field i { position: absolute; width: 900px; height: 900px; border-radius: 50%; background: radial-gradient(closest-side, var(--c), transparent); }
  .pr-hero__field i:nth-child(1) { --c: rgb(18 109 251 / 0.16); left: -200px; top: 120px; }
  .pr-hero__field i:nth-child(2) { --c: rgb(30 187 236 / 0.2); right: -240px; top: 220px; }
  .pr-hero__head > * { animation: rise 700ms var(--ease-out) both; }
  .pr-hero__head > :nth-child(2) { animation-delay: 70ms; }
  .pr-hero__head > :nth-child(3) { animation-delay: 140ms; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  .pr-hero__h { font-size: clamp(2.5rem, 5.6vw, 4.5rem); max-width: 11em; }
  .pr-hero__fee { text-align: center; margin-top: 24px; }

  .legend { list-style: none; margin: 6px 0 0; padding: 0; display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; font-size: 0.875rem; color: var(--ink-3); }
  .legend li { display: inline-flex; align-items: center; gap: 8px; }

  .mark { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; font-size: 13px; font-weight: 700; }
  .mark--y { background: var(--blue-soft); color: var(--blue); box-shadow: inset 0 0 0 1.5px var(--blue); }
  .mark--l { background: #fff4e5; color: #e08600; box-shadow: inset 0 0 0 1.5px #f2a33a; }
  .mark--n { color: #a3a6ab; }

  /* Plan names stay pinned under the nav while the table scrolls. */
  .cmp__head { position: sticky; top: 72px; z-index: 5; margin-bottom: 16px; }
  .cmp__head-in {
    display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); align-items: center;
    padding: 14px 24px; border-radius: 18px;
    background: rgb(255 255 255 / 0.82);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    backdrop-filter: blur(16px) saturate(1.6);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8), 0 0 0 1px rgb(10 10 10 / 0.05);
    transition: box-shadow 250ms ease;
  }
  .cmp__head.is-stuck .cmp__head-in { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8), 0 0 0 1px rgb(10 10 10 / 0.06), 0 16px 32px -20px rgb(10 20 40 / 0.35); }
  .cmp__head-label { font-weight: 600; color: var(--ink-3); font-size: 0.9375rem; }
  .cmp__plan { display: grid; justify-items: center; text-align: center; line-height: 1.2; }
  .cmp__plan b { font-weight: 650; font-size: 0.975rem; }
  .cmp__plan small { color: var(--ink-3); font-size: 0.8125rem; }
  .cmp__plan.is-lead b { color: var(--blue); }

  .cmp__group {
    border-radius: 22px; overflow: hidden;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.92), rgb(255 255 255 / 0.7));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8), 0 0 0 1px rgb(10 10 10 / 0.05);
  }
  .cmp__group + .cmp__group { margin-top: 20px; }
  .cmp__table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .cmp__table col, .cmp__table th, .cmp__table td { }
  .cmp__table thead th { background: rgb(10 10 10 / 0.025); padding: 18px 24px; font-size: 0.9375rem; font-weight: 650; text-align: center; }
  .cmp__table thead .cmp__gtitle { text-align: left; width: 40%; }
  .cmp__colh { color: var(--ink-3); font-weight: 600 !important; }
  .cmp__table tbody th { text-align: left; font-weight: 450; font-size: 0.9375rem; color: #2a2a2e; padding: 14px 24px; }
  .cmp__table tbody td { text-align: center; padding: 14px 8px; }
  .cmp__table tbody tr { border-top: 1px solid var(--line); transition: background-color 150ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .cmp__table tbody tr:hover { background: rgb(18 109 251 / 0.035); }
  }
  .cmp__addon { color: var(--blue); font-weight: 650; font-size: 0.9375rem; }

  .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq__lede { margin-top: 16px; }
  .faq__list { display: grid; gap: 10px; }
  details { background: var(--surface); border-radius: 18px; box-shadow: inset 0 0 0 1px var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 22px; font-weight: 550; font-size: 1.0625rem; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; color: var(--ink-3); transition: transform 300ms var(--ease-out); }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  details p { padding: 0 22px 22px; color: var(--ink-2); }

  .pr-cta { padding: 0 0 clamp(80px, 10vw, 128px); }
  .pr-cta__box { border-radius: 32px; padding: clamp(48px, 8vw, 88px) var(--gutter); text-align: center; background: var(--ink); color: #fff; display: grid; justify-items: center; gap: 18px; }
  .pr-cta__box .lede { color: #b8b8be; }

  @media (max-width: 900px) {
    .faq { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .cmp__head { top: 64px; }
    .cmp__head-in { grid-template-columns: minmax(0, 1fr) repeat(3, 52px); padding: 10px 12px; }
    .cmp__head-label { font-size: 0.8125rem; }
    .cmp__plan small { display: none; }
    .cmp__plan b { font-size: 0.75rem; }
    .cmp__head-in { padding-right: 24px; }
    .cmp__plan b { font-size: 0.8125rem; }
    .cmp__table thead th { padding: 14px 6px; font-size: 0.8125rem; }
    .cmp__table thead .cmp__gtitle { padding-left: 14px; width: 46%; }
    .cmp__colh { display: none; }
    .cmp__table thead .cmp__gtitle { width: auto; }
    .cmp__table thead tr { display: grid; grid-template-columns: 1fr; }
    .cmp__table tbody tr { display: grid; grid-template-columns: minmax(0, 1fr) repeat(3, 52px); align-items: center; padding-right: 12px; }
    .cmp__table tbody th { padding: 12px 6px 12px 14px; font-size: 0.875rem; }
    .cmp__table tbody td { padding: 12px 4px; }
    .cmp__addon { grid-column: span 2; font-size: 0.8125rem; }
  }
  @media (prefers-reduced-motion: reduce) { .pr-hero__head > * { animation: none; } }
  @media (prefers-reduced-transparency: reduce) {
    .cmp__head-in, .cmp__group { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  @media (prefers-contrast: more) {
    .cmp__head-in, .cmp__group { background: var(--surface); box-shadow: 0 0 0 1px var(--ink-3); }
  }
</style>

<script>
  const head = document.querySelector<HTMLElement>('[data-cmp-head]')!;
  const sentinel = document.createElement('div');
  head.before(sentinel);
  new IntersectionObserver(([e]) => head.classList.toggle('is-stuck', !e.isIntersecting), { rootMargin: '-80px 0px 0px 0px' }).observe(sentinel);
</script>
