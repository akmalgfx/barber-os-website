---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import { FORM_ENDPOINTS, LINKS } from '../data/site';
---

<Base title="Contact Us | Barber-OS" description="Get in touch with Barber-OS. We're available 7 days a week during working hours.">
  <Nav />
  <main id="main">
    <section class="page-hero">
      <div class="page-hero__field" aria-hidden="true"><i></i><i></i></div>
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="pill"><Icon name="chat" size={15} /> Contact</span>
          <h1 class="h1">Get In Touch</h1>
          <p class="lede">We're available 7 days a week, during working hours. Just let us know what we can help you with and we'll do our best.</p>
        </div>
      </div>
    </section>

    <section class="contact-sec">
      <div class="wrap contact">
        <div class="contact__form glass" data-reveal>
          <form class="form" data-form data-endpoint={FORM_ENDPOINTS.contact} novalidate>
            <div class="form__row">
              <label class="field"><span class="field__label">Name <i>*</i></span>
                <input name="name" type="text" autocomplete="name" placeholder="John Doe" required /><span class="field__err"></span></label>
              <label class="field"><span class="field__label">Business Name <i>*</i></span>
                <input name="business" type="text" autocomplete="organization" placeholder="Clip Fade Barbershop" required /><span class="field__err"></span></label>
            </div>
            <label class="field"><span class="field__label">Country <i>*</i></span>
              <select name="country" autocomplete="country-name" required>
                <option value="" selected disabled>Select…</option>
                <option>Canada</option><option>United States</option><option>Other</option>
              </select><span class="field__err"></span></label>
            <div class="form__row">
              <label class="field"><span class="field__label">Email <i>*</i></span>
                <input name="email" type="email" autocomplete="email" inputmode="email" placeholder="john@barber-os.com" required /><span class="field__err"></span></label>
              <label class="field"><span class="field__label">Phone <i>*</i></span>
                <input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="833-123-1234" pattern="[\d\s()+.\-]{10,}" required /><span class="field__err"></span></label>
            </div>
            <label class="field"><span class="field__label">Inquiry</span>
              <textarea name="message" placeholder="How can we help?"></textarea></label>
            <input class="sr-only" type="text" name="company_site" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form__foot">
              <button class="btn" type="submit">Submit</button>
              <p class="form__status" data-status role="status" aria-live="polite"></p>
            </div>
          </form>
          <div class="form__done" data-done hidden tabindex="-1">
            <span class="form__done-ico"><Icon name="check" size={24} /></span>
            <h2 class="h3">Thanks, we've got your message</h2>
            <p class="small">Our team will get back to you during working hours.</p>
          </div>
        </div>

        <aside class="contact__side">
          <a class="side-card glass" href={LINKS.support} rel="noopener" data-reveal>
            <span class="side-card__ico"><Icon name="help" size={22} /></span>
            <h2 class="h3">Support & Knowledge Base</h2>
            <p>View the Barber-OS knowledge base or reach out to our support team for assistance.</p>
            <span class="link">Support Portal <Icon name="arrowRight" size={16} /></span>
          </a>
          <a class="side-card glass" href={LINKS.bookDemo} rel="noopener" data-reveal>
            <span class="side-card__ico"><Icon name="calendar" size={22} /></span>
            <h2 class="h3">Book A Demo</h2>
            <p>Schedule a full demo with our team at your convenience.</p>
            <span class="link">Pick a time <Icon name="arrowRight" size={16} /></span>
          </a>
          <div class="side-note" data-reveal>
            <Icon name="clock" size={18} />
            <span>Available 7 days a week, during working hours.</span>
          </div>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .contact-sec { padding: 24px 0 clamp(80px, 10vw, 128px); }
  .contact { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .contact__form { padding: clamp(24px, 4vw, 40px); }
  .contact__side { display: grid; gap: 16px; }
  .side-card {
    display: grid; gap: 10px; padding: 26px; text-decoration: none; color: inherit;
    transition: transform 300ms var(--ease-out);
  }
  .side-card p { color: var(--ink-2); font-size: 0.975rem; }
  .side-card .link :global(svg) { transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .side-card:hover { transform: translateY(-3px); }
    .side-card:hover .link :global(svg) { transform: translateX(3px); }
  }
  .side-card:active { transform: scale(0.99); }
  .side-card__ico { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: var(--blue); background: var(--blue-soft); }
  .side-note { display: flex; align-items: center; gap: 10px; padding: 4px 6px; color: var(--ink-3); font-size: 0.9375rem; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
</style>

<script>
  import { mountForms } from '../data/forms';
  mountForms();

  // A hardware setup sent from /pos-hardware arrives as ?setup=… and starts the inquiry.
  const setup = new URLSearchParams(location.search).get('setup');
  const msg = document.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
  if (setup && msg && !msg.value) msg.value = `I'd like a quote for this hardware setup: ${setup.slice(0, 400)}.`;
</script>
